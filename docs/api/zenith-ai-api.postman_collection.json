          "response": []
        },
        {
          "name": "Profile PUT is not allowed",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/profile/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "profile", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 405\", function () {",
                  "    pm.response.to.have.status(405);",
                  "});",
                  "",
                  "pm.test(\"Error uses the method_not_allowed envelope\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error.code).to.eql(\"method_not_allowed\");",
                  "    pm.expect(jsonData.error.message).to.be.a(\"string\");",
                  "    pm.expect(jsonData.error.details).to.eql({});",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test(\"The refresh token is blacklisted\", function () {",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get(\"base_url\") + \"/api/v1/auth/token/refresh/\",",
                  "        method: \"POST\",",
                  "        header: { \"Content-Type\": \"application/json\" },",
                  "        body: { mode: \"raw\", raw: JSON.stringify({ refresh: pm.environment.get(\"refresh_token\") }) }",
                  "    }, function (err, res) {",
                  "        pm.expect(err).to.eql(null);",
                  "        pm.expect(res.code).to.eql(401);",
                  "        var jsonData = res.json();",
                  "        pm.expect(jsonData.error.code).to.eql(\"unauthorized\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Conversations",
      "description": "Conversation CRUD, pagination and ownership",
      "item": [
        {
          "name": "Create Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chat/conversations/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "chat", "conversations", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"My First Conversation\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Save the conversation uuid\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.uuid).to.be.a(\"string\");",
                  "    pm.expect(jsonData.message_count).to.eql(0);",
                  "    pm.expect(jsonData).to.not.have.property(\"messages\");",
                  "    pm.environment.set(\"conversation_uuid\", jsonData.uuid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chat/conversations/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "chat", "conversations", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"List responses paginate with the shared envelope\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"count\");",
                  "    pm.expect(jsonData).to.have.property(\"next\");",
                  "    pm.expect(jsonData).to.have.property(\"previous\");",
                  "    pm.expect(jsonData.results).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Items are lean and carry message_count\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.results.length > 0) {",
                  "        var item = jsonData.results[0];",
                  "        pm.expect(item.uuid).to.be.a(\"string\");",
                  "        pm.expect(item.message_count).to.be.a(\"number\");",
                  "        pm.expect(item).to.not.have.property(\"messages\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
