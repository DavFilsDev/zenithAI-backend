{
  "info": {
    "name": "ZenithAI API v1",
    "description": "Contract collection for the ZenithAI API, versioned under /api/v1. Requests are meant to run in order: the Authentication folder logs in and saves access_token/refresh_token, the Conversations folder saves conversation_uuid from the create response, and Logout must run last because it blacklists the current refresh token.\n\nError responses are asserted with the shared envelope {error: {code, message, details}}. Sending a message needs a live Gemini key: a missing or invalid key returns 503 llm_unavailable.\n\nThrottling is not implemented yet (P2.8): no endpoint returns 429 today. The rate-limit request below asserts the rate_limited envelope only when a 429 is actually received, and a live 429 opens together with the P2.8 throttle scopes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Registration, tokens, profile and logout",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"username\": \"testuser\",\n    \"password\": \"Sterlin!Str0ng-42\",\n    \"password2\": \"Sterlin!Str0ng-42\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Payload carries email and username but never the password\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.email).to.eql(\"test@example.com\");",
                  "    pm.expect(jsonData.username).to.eql(\"testuser\");",
                  "    pm.expect(jsonData).to.not.have.property(\"password\");",
                  "    pm.expect(jsonData).to.not.have.property(\"password2\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login - Get Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"Sterlin!Str0ng-42\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Save access and refresh tokens\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access).to.be.a(\"string\");",
                  "    pm.expect(jsonData.refresh).to.be.a(\"string\");",
                  "    pm.environment.set(\"access_token\", jsonData.access);",
                  "    pm.environment.set(\"refresh_token\", jsonData.refresh);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token", "refresh", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Save the rotated refresh token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access).to.be.a(\"string\");",
                  "    pm.expect(jsonData.refresh).to.be.a(\"string\");",
                  "    pm.environment.set(\"access_token\", jsonData.access);",
                  "    pm.environment.set(\"refresh_token\", jsonData.refresh);",
                  "});",
                  "",
                  "pm.test(\"The refresh token is single-use\", function () {",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get(\"base_url\") + \"/api/v1/auth/token/refresh/\",",
                  "        method: \"POST\",",
                  "        header: { \"Content-Type\": \"application/json\" },",
                  "        body: { mode: \"raw\", raw: JSON.stringify({ refresh: pm.environment.get(\"refresh_token\") }) }",
                  "    }, function (err, res) {",
                  "        pm.expect(err).to.eql(null);",
                  "        pm.expect(res.code).to.eql(401);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
