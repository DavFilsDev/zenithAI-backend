SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1

# the settings read the allowed origins from this variable
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_NAME=zenith_ai_db
DB_USER=zenith_ai
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Production: use the Neon pooled URL for the app and the direct URL for migrations.
# Leave these empty locally; the DB_* values above are then used.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# LLM configuration: provider selection and keys (contract section 11)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# LLM_FALLBACK_PROVIDER is used automatically when the primary is unavailable
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Token budget for the conversation history sent with each request
LLM_PROMPT_BUDGET=4000

# Global maximum messages per day across all users (contract section 9)
DAILY_MESSAGE_CAP=500

# Provider circuit breaker: fail fast after this many consecutive failures,
# then retry after this many seconds
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN=60
