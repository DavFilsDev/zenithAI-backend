    {
      "name": "Messages",
      "description": "Nested message resource of a conversation",
      "item": [
        {
          "name": "List Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chat/conversations/{{conversation_uuid}}/messages/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "chat", "conversations", "{{conversation_uuid}}", "messages", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Messages paginate and carry role and content\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"count\");",
                  "    pm.expect(jsonData.results).to.be.an(\"array\");",
                  "    if (jsonData.results.length > 0) {",
                  "        pm.expect(jsonData.results[0].role).to.be.a(\"string\");",
                  "        pm.expect(jsonData.results[0].content).to.be.a(\"string\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chat/conversations/{{conversation_uuid}}/messages/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "chat", "conversations", "{{conversation_uuid}}", "messages", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"What is the capital of France?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Assistant message is returned\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.role).to.eql(\"assistant\");",
                  "        pm.expect(jsonData.content).to.be.a(\"string\");",
                  "        pm.expect(jsonData.uuid).to.be.a(\"string\");",
                  "    });",
                  "} else if (pm.response.code === 503) {",
                  "    pm.test(\"Provider failure returns the llm_unavailable envelope\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.error.code).to.eql(\"llm_unavailable\");",
                  "        pm.expect(jsonData.error.message).to.be.a(\"string\");",
                  "        pm.expect(jsonData.error.details).to.eql({});",
                  "    });",
                  "} else {",
